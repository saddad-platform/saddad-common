# Maven build output - never commit compiled classes/jars, they are reproducible from source.
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Stray local runtime artifacts (relative paths resolve differently depending on
# whatever cwd a process was launched from) - never real data, safe to delete anytime.
data/
