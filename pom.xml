<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
        <relativePath/>
    </parent>

    <!--
        JitPack coordinates.

        The group id is not a choice: JitPack serves every GitHub repository as
        `com.github.<owner>`, with the repository name as the artifact id and the git tag as the
        version. Nothing is uploaded anywhere - JitPack clones the tag, builds it, and serves
        what the build produced. See RELEASING.md.
    -->
    <groupId>com.github.saddad-platform</groupId>
    <artifactId>saddad-common</artifactId>
    <!--
        The released version, and the name of the git tag that produces it.

        With JitPack the git tag *is* the version a consumer writes, so the two must be the same
        text: tag `1.0.1` and this says `1.0.1`. Tags carry no `v` prefix here for that reason -
        a `v1.0.1` tag would make every service's POM read `<version>v1.0.1</version>`. The
        release workflow checks the two agree and refuses to go on if they do not.
    -->
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <name>SADAD Platform :: Common</name>
    <description>Standalone shared technical library for the SADAD platform: API envelope, exceptions, security, persistence base entities, messaging envelope and web filters. Not a dumping ground for domain/business logic.</description>
    <url>https://github.com/saddad-platform/saddad-common</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>SADAD Platform</name>
        <url>https://github.com/saddad-platform</url>
    </organization>

    <!--
        The licence.

        JitPack does not require one - it builds and serves whatever the tag contains - so this
        no longer blocks a release the way Maven Central did. It is still worth declaring:
        without it, anyone reading the repository has no idea what they are permitted to do with
        the code, and the safe assumption is "nothing".

        To declare one, add a LICENSE file to the repository root and uncomment this:

        <licenses>
            <license>
                <name>Apache License, Version 2.0</name>
                <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
                <distribution>repo</distribution>
            </license>
        </licenses>
    -->

    <developers>
        <!--
            The organisation rather than a person: the repository's own history is the only
            evidence available here of who maintains it, and publishing an individual's name
            and address to a permanent public index is their decision to make, not this file's.
            A named maintainer can be added alongside this entry at any time.
        -->
        <developer>
            <id>saddad-platform</id>
            <name>SADAD Platform</name>
            <organization>SADAD Platform</organization>
            <organizationUrl>https://github.com/saddad-platform</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/saddad-platform/saddad-common.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/saddad-platform/saddad-common.git</developerConnection>
        <url>https://github.com/saddad-platform/saddad-common</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/saddad-platform/saddad-common/issues</url>
    </issueManagement>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Pinned rather than left to resolve, so a build on JitPack's machine uses the same
             tools as a build on yours and a Javadoc failure is reproducible locally. -->
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    
        <!--
            Newer than the version Spring Boot 3.3.3 manages (1.18.34).

            Lombok reaches into javac's internals, so a JDK patch release can break it outright:
            on JDK 21.0.12 the older version dies with
            "ExceptionInInitializerError: com.sun.tools.javac.code.TypeTag :: UNKNOWN" and every
            @Getter, @Builder and @Slf4j in the build silently stops generating. The symptom is
            hundreds of "cannot find symbol" errors against source that is perfectly correct,
            which sends you looking in exactly the wrong place. Pinning a version that knows
            about current JDKs is the fix; keep it ahead of whatever JDK the team runs.
        -->
        <lombok.version>1.18.42</lombok.version>

        <!--
            Newer than the version Spring Boot 3.3.3 manages (1.14.19).

            Byte Buddy generates the mock classes Mockito uses, so it has to understand the
            class file version the JDK emits. On JDK 21.0.12 the older version cannot, and every
            test that mocks anything fails with "Mockito cannot mock this class" - naming a class
            that is perfectly ordinary, which sends you looking at the class instead of at the
            toolchain. Same family of problem as the Lombok pin, same fix.
        -->
        <byte-buddy.version>1.17.8</byte-buddy.version>
</properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Raw templating engine only (not spring-boot-starter-freemarker) - this platform
             never renders FreeMarker as an MVC view, only as a string-in/string-out
             renderer for admin-configured email/SMS template bodies (see
             common.core.util.TemplateRenderingUtil), so the MVC view-resolver
             autoconfiguration that starter would pull in is unwanted. -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Sources and Javadoc, for the people who use this library.

        In a profile rather than the default build because Javadoc generation is the slowest
        part of the build and nobody developing needs it: `mvn verify` stays fast, and the two
        places that do want them - JitPack, via jitpack.yml, and verify.sh - ask for them.

        There is nothing else here any more. Publishing to Maven Central needed signing keys, a
        verified namespace, an account token and a staging plugin; JitPack needs a git tag.
    -->
    <!--
        The module had no top-level <build> at all - the only one here lives inside the release
        profile, so anything added there never applies to an ordinary `mvn compile`.
    -->
    <build>
        <plugins>
            <!--
                Lombok is named as an annotation processor explicitly rather than being left to
                be discovered on the classpath. Implicit discovery hides a processor failure as
                hundreds of "cannot find symbol" errors against correct source; naming the path
                makes it a declared, versioned build input that fails loudly instead.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!--
                                Doclint off, deliberately and narrowly. This library's Javadoc is
                                prose explaining why the code is the way it is rather than a
                                tag-complete API reference, and doclint fails a build on a
                                missing @param in a private helper. Genuine errors still fail -
                                see failOnError.
                            -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <notimestamp>true</notimestamp>
                            <failOnError>true</failOnError>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
