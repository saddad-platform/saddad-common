<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
        <relativePath/>
    </parent>

    <!--
        Public Maven Central coordinates.

        The group id is the `io.github.<organisation>` namespace that Maven Central grants on
        proof of ownership of the GitHub organisation of the same name - which is why it is
        this rather than the internal `com.sadad`: a namespace can only be published under by
        whoever can prove they own it, and nobody can prove ownership of `com.sadad` without
        the sadad.com domain. See RELEASING.md for the one-time verification step.
    -->
    <groupId>io.github.saddad-platform</groupId>
    <artifactId>saddad-common</artifactId>
    <!--
        The released version, not a SNAPSHOT.

        A release is cut by setting this to the version being released, committing it, and
        publishing a GitHub Release tagged `v<version>`. The workflow refuses to publish if the
        tag and this number disagree, or if this is a SNAPSHOT, so the artifact that reaches
        Maven Central can only ever be the one the tag names. See RELEASING.md.
    -->
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SADAD Platform :: Common</name>
    <description>Standalone shared technical library for the SADAD platform: API envelope, exceptions, security, persistence base entities, messaging envelope and web filters. Not a dumping ground for domain/business logic.</description>
    <url>https://github.com/saddad-platform/saddad-common</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>SADAD Platform</name>
        <url>https://github.com/saddad-platform</url>
    </organization>

    <!--
        MANUAL CONFIGURATION REQUIRED - the licence.

        Maven Central rejects a POM with no <licenses> block, and this repository contains no
        LICENSE file, no licence headers and no statement of licensing anywhere: there is
        nothing here to read the project's licensing intent from. Choosing one is the owner's
        decision and not a detail to be guessed at by tooling, so it is deliberately left
        undone rather than filled in with a plausible default.

        To complete it: add a LICENSE file to the repository root and uncomment the matching
        block below. The release workflow checks for both and stops with this same explanation
        before anything is signed or uploaded.

        <licenses>
            <license>
                <name>Apache License, Version 2.0</name>
                <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
                <distribution>repo</distribution>
            </license>
        </licenses>
    -->

    <developers>
        <!--
            The organisation rather than a person: the repository's own history is the only
            evidence available here of who maintains it, and publishing an individual's name
            and address to a permanent public index is their decision to make, not this file's.
            A named maintainer can be added alongside this entry at any time.
        -->
        <developer>
            <id>saddad-platform</id>
            <name>SADAD Platform</name>
            <organization>SADAD Platform</organization>
            <organizationUrl>https://github.com/saddad-platform</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/saddad-platform/saddad-common.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/saddad-platform/saddad-common.git</developerConnection>
        <url>https://github.com/saddad-platform/saddad-common</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/saddad-platform/saddad-common/issues</url>
    </issueManagement>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jjwt.version>0.12.6</jjwt.version>

        <!-- Pinned rather than inherited or left to resolve. A release is reproducible only
             if the tools that build it are the same ones next time; a plugin that drifts
             turns a signing or Javadoc failure into a mystery nobody can reproduce. -->
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Raw templating engine only (not spring-boot-starter-freemarker) - this platform
             never renders FreeMarker as an MVC view, only as a string-in/string-out
             renderer for admin-configured email/SMS template bodies (see
             common.core.util.TemplateRenderingUtil), so the MVC view-resolver
             autoconfiguration that starter would pull in is unwanted. -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        How a release reaches Maven Central.

        Kept in a profile rather than in the default build, because everything in it is for
        publishing and none of it is for developing: a contributor running `mvn verify` should
        not need a GPG key, and should not pay for Javadoc generation on every build. The
        release workflow is the only thing that passes `-Prelease`.

        This replaces publishing to GitHub Packages. GitHub Packages requires a token for every
        read - including a public package inside your own organisation - so every consumer,
        human or machine, had to be issued a credential before it could resolve one dependency.
        Maven Central requires none, which is the entire point of the move.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Required by Maven Central: the sources that produced the jar. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Required by Maven Central: the API documentation. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!--
                                Doclint off, deliberately and narrowly.

                                This library's Javadoc is prose explaining why the code is the
                                way it is rather than a tag-complete API reference, and doclint
                                fails a build on a missing @param in a private helper. The
                                choice is between a release that cannot be cut and
                                documentation generated as written; rewriting sixty files of
                                comments to satisfy a linter is not a publishing change.
                                Genuine errors still fail the build - see failOnError.
                            -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <notimestamp>true</notimestamp>
                            <failOnError>true</failOnError>
                        </configuration>
                    </plugin>

                    <!--
                        Required by Maven Central: a detached signature for every artifact.

                        The key and its passphrase arrive as environment variables from GitHub
                        Actions secrets and are never written into the repository.
                        The loopback pinentry argument below is what lets gpg take a
                        passphrase from the batch environment instead of trying to open a
                        prompt on a machine that has no terminal.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        The current Sonatype Central Portal publisher, not the retired OSSRH
                        staging API. `extensions` makes it this project's deployment mechanism,
                        so `mvn deploy` uploads the bundle to the portal.

                        autoPublish releases it without somebody pressing a button in the
                        portal, and waitUntil=published means the Maven run does not report
                        success until Maven Central has actually published the version - so the
                        workflow's "SUCCESS" and the state of the world agree.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
